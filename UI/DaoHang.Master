<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="DaoHang.master.cs" Inherits="UI.DaoHang" %>

<!DOCTYPE html>

<html>
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title></title>
    <style>
        a:link {
        color:white;
        text-decoration:none;

        }
        a:hover {
        color:white;
        text-decoration:none;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <div style="width:100%;height:60px;background-color:lightgray;line-height:60px">
                <div style="width:50%;float:left">您好：<%=Session["username"].ToString()%>，欢迎使用学生信息管理系统</div>
                <div style="width:50%;float:left;text-align:right">
                    <a href="StudentList.aspx">网站首页</a>
                     <a href="UpdatePwd.aspx">修改密码</a>
                    <asp:LinkButton ID="LinkButton1" runat="server" OnClick="LinkButton1_Click">注销</asp:LinkButton>
                </div>
            </div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
